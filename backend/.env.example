DB_PASSWORD=replace-with-issued-password
# Optional: daily 00:05 Asia/Seoul. Restart the backend after changing these values.
# PROFILE_REFRESH_ENABLED=true
# PROFILE_REFRESH_CRON=0 5 0 * * *
# Optional: telemetry expires to UNKNOWN after 300 seconds. Positive value required.
# DEVICE_STATUS_MAX_AGE_SECONDS=300
# Robot integration: use the registered device ID and a separately shared token (32+ characters).
# ROBOT_DEVICE_ID=registered-device-id
# ROBOT_DEVICE_TOKEN=replace-with-a-random-secret-at-least-32-characters
# Recommended for 1-second robot telemetry:
# DEVICE_STATUS_MAX_AGE_SECONDS=10
# Optional: PAUSE is available only while a non-UNKNOWN movement report is newer than this.
# ROBOT_CONTROL_STATUS_MAX_AGE_SECONDS=10
# Comma-separated frontend origins. Do not add a trailing slash.
# APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://192.168.0.10:5173
